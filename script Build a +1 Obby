-- Variables
local isCollecting = false
local totalCollected = 0
local collectZones = {}
local lastCashValue = cash.Value

-- Find all Collect Zones
local function findCollectZones()
	local workspace = game:GetService("Workspace")
	for _, zone in pairs(workspace:GetDescendants()) do
		if zone.Name:match("Collect") or zone.Name:match("collect") or zone.Name:match("Zone") then
			if zone:IsA("BasePart") then
				table.insert(collectZones, zone)
			end
		end
	end
	print("Found " .. #collectZones .. " collect zones")
end

findCollectZones()

-- Update Cash Label
local function updateCashLabel()
	cashLabel.Text = "💰 Cash: $" .. tostring(math.floor(cash.Value))
	if cash.Value > lastCashValue then
		totalCollected = totalCollected + (cash.Value - lastCashValue)
		collectedLabel.Text = "📦 Collected This Session: " .. tostring(math.floor(totalCollected))
		lastCashValue = cash.Value
		
		-- Pulse effect
		cashLabel.TextSize = 22
		game:GetService("TweenService"):Create(
			cashLabel,
			TweenInfo.new(0.3),
			{TextSize = 20}
		):Play()
	end
end

cash.Changed:Connect(updateCashLabel)
updateCashLabel()

-- Auto-move to Collect Zones
local function moveToZone()
	if not isCollecting then return end
	
	while isCollecting do
		if #collectZones > 0 then
			local zone = collectZones[math.random(1, #collectZones)]
			if zone and zone.Parent then
				statusLabel.Text = "🔵 Status: Moving to Zone..."
				humanoidRootPart.CFrame = zone.CFrame + Vector3.new(0, 3, 0)
				wait(0.5)
			end
		end
		wait(0.1)
	end
end

-- Animation Loop
local function animateGUI()
	while isCollecting do
		-- Floating animation
		mainFrame.Position = UDim2.new(0.5, -175, 0, 20 + math.sin(tick() * 2) * 5)
		wait(0.05)
	end
end

-- Start Collecting
local function startCollecting()
	if isCollecting then return end
	isCollecting = true
	statusLabel.Text = "🟢 Status: Collecting..."
	statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
	controlButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	controlButton.Text = "⏹️ STOP COLLECTING"
	
	-- Start animations and movement in parallel
	task.spawn(moveToZone)
	task.spawn(animateGUI)
end

-- Stop Collecting
local function stopCollecting()
	isCollecting = false
	statusLabel.Text = "🟡 Status: Stopped"
	statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
	controlButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
	controlButton.Text = "▶️ START COLLECTING"
	mainFrame.Position = UDim2.new(0.5, -175, 0, 20)
end

-- Button Click Event
controlButton.MouseButton1Click:Connect(function()
	if isCollecting then
		stopCollecting()
	else
		startCollecting()
	end
end)

-- Cleanup
player.AncestryChanged:Connect(function()
	if not player.Parent then
		isCollecting = false
	end
end)