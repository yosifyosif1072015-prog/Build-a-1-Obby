-- Find Collect Zones
local function findCollectZones()
	local zones = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local name = obj.Name:lower()
			if string.find(name, "collect") then
				table.insert(zones, obj)
			end
		end
	end
	return zones
end

-- Get Nearest Zone
local function getNearestZone()
	local zones = findCollectZones()
	local nearest = nil
	local minDist = math.huge
	
	for _, zone in ipairs(zones) do
		if zone and zone.Parent then
			local dist = (zone.Position - hrp.Position).Magnitude
			if dist < minDist then
				minDist = dist
				nearest = zone
			end
		end
	end
	
	return nearest
end

-- Collect Loop
local function startCollecting()
	if isCollecting then return end
	isCollecting = true
	collectButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	collectButton.Text = "⏹️ Stop Collect"
	
	while isCollecting do
		local zone = getNearestZone()
		if zone then
			hrp.CFrame = zone.CFrame + Vector3.new(0, 3, 0)
		end
		wait(0.2)
	end
end

-- Stop Collecting
local function stopCollecting()
	isCollecting = false
	collectButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
	collectButton.Text = "🔄 Start Collect"
end

-- Button Click Event
collectButton.MouseButton1Click:Connect(function()
	if isCollecting then
		stopCollecting()
	else
		startCollecting()
	end
end)

-- Character respawn
player.CharacterAdded:Connect(function(newChar)
	character = newChar
	hrp = character:WaitForChild("HumanoidRootPart")
	if isCollecting then
		stopCollecting()
	end
end)

-- Cleanup on player leaving
player.AncestryChanged:Connect(function()
	if not player.Parent then
		isCollecting = false
	end
end)