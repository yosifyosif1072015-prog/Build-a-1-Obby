-- اختبر كل Remotes
local testItems = {
	"Candy Keyboard",
	"Chocolate Keyboard",
	"CandyKeyboard",
	"ChocolateKeyboard",
	"Treadmill",
	"x1 Treadmill",
	"Shoes",
	"x1 Shoes",
	"WaxNeedoh"
}

for _, remoteName in ipairs(purchaseRemotes) do
	local button = Instance.new("TextButton")
	button.Name = "TestButton_" .. remoteName.name
	button.Size = UDim2.new(1, -10, 0, 40)
	button.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 12
	button.Font = Enum.Font.Gotham
	button.Text = "Test: " .. remoteName.name
	button.Parent = scrollFrame

	button.MouseButton1Click:Connect(function()
		print("Testing Remote:", remoteName.path)
		
		local parts = string.split(remoteName.path, ".")
		local remote = ReplicatedStorage
		
		for _, part in ipairs(parts) do
			remote = remote:FindFirstChild(part)
			if not remote then break end
		end
		
		if remote then
			for _, itemName in ipairs(testItems) do
				print("  -> Firing:", itemName)
				if remote:IsA("RemoteEvent") then
					remote:FireServer(itemName)
				elseif remote:IsA("RemoteFunction") then
					remote:InvokeServer(itemName)
				end
				task.wait(0.3)
			end
		end
	end)
end

-- زر للشراء التلقائي
local buyAllButton = Instance.new("TextButton")
buyAllButton.Name = "BuyAllButton"
buyAllButton.Size = UDim2.new(1, -20, 0, 40)
buyAllButton.Position = UDim2.new(0, 10, 1, -50)
buyAllButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
buyAllButton.TextColor3 = Color3.fromRGB(255, 255, 255)
buyAllButton.TextSize = 14
buyAllButton.Font = Enum.Font.GothamBold
buyAllButton.Text = "🛒 BUY CANDY + CHOCOLATE (Auto)"
buyAllButton.Parent = mainFrame

local isBuying = false

buyAllButton.MouseButton1Click:Connect(function()
	if isBuying then
		isBuying = false
		buyAllButton.Text = "🛒 BUY CANDY + CHOCOLATE (Auto)"
		buyAllButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		return
	end

	isBuying = true
	buyAllButton.Text = "⏸️ STOP"
	buyAllButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)

	task.spawn(function()
		while isBuying do
			-- جرّب كل Remotes
			for _, remoteName in ipairs(purchaseRemotes) do
				local parts = string.split(remoteName.path, ".")
				local remote = ReplicatedStorage
				
				for _, part in ipairs(parts) do
					remote = remote:FindFirstChild(part)
					if not remote then break end
				end
				
				if remote then
					print("Trying Remote:", remoteName.name)
					if remote:IsA("RemoteEvent") then
						remote:FireServer("Candy Keyboard")
						task.wait(0.3)
						remote:FireServer("Chocolate Keyboard")
					end
				end
			end
			
			task.wait(1)
		end
	end)
end)

