-- Dragging
local dragging = false
local dragStart = nil
local startPos = nil

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Variables
local isCollecting = false

local function findCollectZones()
    local zones = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if string.find(name, "collect") then
                table.insert(zones, obj)
            end
        end
    end
    return zones
end

local function getNearestZone(zones)
    local nearest = nil
    local minDist = math.huge
    
    for _, zone in ipairs(zones) do
        if zone and zone.Parent then
            local dist = (zone.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = zone
            end
        end
    end
    
    return nearest
end

local function collectZones()
    while isCollecting do
        local zones = findCollectZones()
        if #zones > 0 then
            local zone = getNearestZone(zones)
            if zone then
                statusLabel.Text = "Moving..."
                hrp.CFrame = zone.CFrame + Vector3.new(0, 3, 0)
            end
        else
            statusLabel.Text = "No zones"
        end
        wait(0.2)
    end
end

local function startCollect()
    if isCollecting then return end
    isCollecting = true
    collectButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    collectButton.Text = "Stop"
    statusLabel.Text = "Collecting..."
    task.spawn(collectZones)
end

local function stopCollect()
    isCollecting = false
    collectButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    collectButton.Text = "Start"
    statusLabel.Text = "Stopped"
end

collectButton.MouseButton1Click:Connect(function()
    if isCollecting then
        stopCollect()
    else
        startCollect()
    end
end)

-- Character respawn
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    hrp = character:WaitForChild("HumanoidRootPart")
    if isCollecting then
        stopCollect()
    end
end)