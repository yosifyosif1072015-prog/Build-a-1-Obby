buyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
buyButton.TextSize = 16
buyButton.Font = Enum.Font.GothamBold
buyButton.Text = "Buy All"
buyButton.Parent = mainFrame

local isBuying = false

buyButton.MouseButton1Click:Connect(function()
	if isBuying then
		isBuying = false
		buyButton.Text = "Buy All"
		buyButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		statusLabel.Text = "Stopped"
		return
	end

	isBuying = true
	buyButton.Text = "Stop"
	buyButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	statusLabel.Text = "Buying..."

	task.spawn(function()
		while isBuying do
			print("Buying: Candy Keyboard")
			remoteEvent:FireServer("Candy Keyboard")
			task.wait(0.3)
			
			print("Buying: Chocolate Keyboard")
			remoteEvent:FireServer("Chocolate Keyboard")
			task.wait(0.3)
		end
	end)
end)

