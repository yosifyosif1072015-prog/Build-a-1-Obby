local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

print("=== STARTING SHOP AUTO BUY ===")

-- Find the correct path
local function findRemote(pathString)
	local current = ReplicatedStorage
	for part in string.gmatch(pathString, "([^.]+)") do
		current = current:FindFirstChild(part)
		if not current then return nil end
	end
	return current
end

-- The correct path from the logs
local networkPath = "GameSystems.Packages.Networker.leifstout_networker@0.3.0.networker._remotes"
local networkFolder = findRemote(networkPath)

if not networkFolder then
	print("❌ Network folder not found!")
	return
end

print("✓ Network folder found")

-- Test each service
local services = {"StockService", "UpgradeService", "PlotService", "ObbyTypeService"}
local remoteEvent = nil
local serviceName = nil

for _, service in ipairs(services) do
	local serviceFolder = networkFolder:FindFirstChild(service)
	if serviceFolder then
		local event = serviceFolder:FindFirstChild("RemoteEvent")
		if event then
			print("Testing:", service)
			remoteEvent = event
			serviceName = service
			
			-- Try to buy
			remoteEvent:FireServer("Candy Keyboard")
			task.wait(0.5)
			remoteEvent:FireServer("Chocolate Keyboard")
			task.wait(0.5)
			
			print("✓ Fired to:", serviceName)
		end
	end
end

if not remoteEvent then
	print("❌ No RemoteEvent found!")
	return
end

print("✓ Using Service:", serviceName)

