-- Draggable UI
local dragging = false
local dragStart
local startPos

local function updateDrag(input)
    if dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

userInputService = game:GetService("UserInputService")
userInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateDrag(input)
    end
end)

-- Collect zone detection
local function getCollectZones()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if string.find(name, "collect") or string.find(name, "zone") or string.find(name, "cash") then
                table.insert(list, obj)
            end
        end
    end
    return list
end

local isActive = false
local collectZones = {}

local function findNearestZone()
    local nearest = nil
    local nearestDist = math.huge
    local rootPos = hrp.Position

    for _, zone in ipairs(collectZones) do
        if zone and zone.Parent and zone:IsA("BasePart") then
            local dist = (zone.Position - rootPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = zone
            end
        end
    end

    return nearest
end

local function moveToCollectZone()
    if not isActive then return end

    while isActive do
        collectZones = getCollectZones()

        if #collectZones > 0 then
            local zone = findNearestZone()
            if zone then
                statusLabel.Text = "Moving to zone..."
                hrp.CFrame = zone.CFrame + Vector3.new(0, 3, 0)
                wait(0.3)
            end
        else
            statusLabel.Text = "No collect zone found"
        end

        wait(0.25)
    end
end

local function startCollecting()
    if isActive then return end
    isActive = true
    button.BackgroundColor3 = Color3.fromRGB(200, 64, 64)
    button.Text = "Stop Collect"
    statusLabel.Text = "Collecting..."
    task.spawn(moveToCollectZone)
end

local function stopCollecting()
    isActive = false
    button.BackgroundColor3 = Color3.fromRGB(19, 181, 87)
    button.Text = "Start Collect"
    statusLabel.Text = "Stopped"
end

button.MouseButton1Click:Connect(function()
    if isActive then
        stopCollecting()
    else
        startCollecting()
    end
end)

