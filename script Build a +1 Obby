-- Auto Buy Shop Items
-- Works by detecting buttons in the shop UI such as Buy, Purchase, Candy Keyboard, Chocolate Keyboard.
-- If your shop uses different texts, this script will still try to click buttons containing the item names.

local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AutoBuyShopGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 260, 0, 120)
main.Position = UDim2.new(0.5, -130, 0, 20)
main.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
main.BorderSizePixel = 0
main.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = main

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 28)
title.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
title.Text = "Auto Buy Shop"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.Parent = main

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 18)
status.Position = UDim2.new(0, 10, 0, 36)
status.BackgroundTransparency = 1
status.Text = "Ready"
status.TextColor3 = Color3.fromRGB(120, 255, 120)
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.Parent = main

local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -20, 0, 38)
button.Position = UDim2.new(0, 10, 0, 62)
button.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
button.Text = "Start Buy All"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Font = Enum.Font.GothamBold
button.TextSize = 15
button.Parent = main

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 10)
btnCorner.Parent = button

local isRunning = false

local function buttonTextMatches(text)
    local lower = text:lower()
    return lower:find("buy") or lower:find("purchase") or lower:find("candy") or lower:find("chocolate") or lower:find("keyboard")
end

local function clickButtonsInShop()
    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("TextButton") then
            local txt = obj.Text or ""
            if buttonTextMatches(txt) then
                obj:Activate()
                wait(0.18)
            end
        end
    end
end

local function buyLoop()
    while isRunning do
        status.Text = "Buying..."
        status.TextColor3 = Color3.fromRGB(120, 255, 120)
        clickButtonsInShop()
        wait(0.3)
    end
end

button.MouseButton1Click:Connect(function()
    if isRunning then
        isRunning = false
        button.Text = "Start Buy All"
        button.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        status.Text = "Stopped"
        status.TextColor3 = Color3.fromRGB(255, 200, 100)
    else
        isRunning = true
        button.Text = "Stop Buy All"
        button.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        task.spawn(buyLoop)
    end
end)

-- Optional: keep the UI draggable
local dragging = false
local dragStart
local startPos

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

main.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)
